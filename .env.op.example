# 1Password references for the XSIAM credentials. Copy to .env.op (git ignores
# it), set your vault and item, then run:
#   op run --env-file=.env.op -- poetry run python src/main.py
# See docs/SECRETS.md. Item ids beat titles: op item get "<title>" --format json | jq -r .id
CORTEX_MCP_PAPI_URL=op://Example Vault/XSIAM example tenant Tier1/url
CORTEX_MCP_PAPI_AUTH_HEADER=op://Example Vault/XSIAM example tenant Tier1/credential
CORTEX_MCP_PAPI_AUTH_ID=op://Example Vault/XSIAM example tenant Tier1/auth_id

# Credential broker profiles: one line per key named in XSIAM_CREDENTIAL_PROFILES.
# XSIAM_T1_KEY=op://Example Vault/XSIAM example tenant Tier1/credential
# XSIAM_T1_KEY_ID=op://Example Vault/XSIAM example tenant Tier1/auth_id
