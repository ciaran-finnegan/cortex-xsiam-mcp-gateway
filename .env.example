CORTEX_MCP_PAPI_URL=https://api-your-xsiam-tenant.example
# CORTEX_MCP_PAPI_AUTH_HEADER and CORTEX_MCP_PAPI_AUTH_ID: inject at start from
# 1Password (.env.op.example), the macOS Keychain or Windows SecretStore, never
# here. See docs/SECRETS.md.

MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/api/v1/stream/mcp
MCP_ALLOW_UNAUTHENTICATED_HTTP=false

LOG_SEARCH_DATASET_POLICY={"Security":["*"],"Tier1":["xdr_data"],"learner":["xql_query_center_history"]}
LOG_SEARCH_DEFAULT_PRINCIPAL_ID=service-account
LOG_SEARCH_DEFAULT_GROUPS=
RAW_XQL_PRIVILEGED_GROUPS=Security,Admin
TOOL_ACCESS_POLICY={"Admin":["*"],"Security":["*"],"Tier1":["get_dataset_query_guidance","get_xql_help","find_datasets","resolve_entity","firewall_traffic","firewall_verdict","entity_activity","dataset_health","threat_intel_lookup","coverage_gap","list_log_datasets","discover_log_fields","query_dataset","continue_dataset_query","search_logs","get_xql_query_quota","get_cases","get_issues","set_engagement","get_engagement","record_fact","get_engagement_log","get_learned_facts"],"learner":["query_dataset","discover_log_fields"]}

# Optional operator-authored catalogue overlay for site-specific datasets. Keep it outside the repository.
DATASET_CATALOGUE_OVERLAY_PATH=

# Engagement modes. The store directory must be absolute and outside any git working tree.
ENGAGEMENT_STORE_DIR=
ENGAGEMENT_MODE_POLICY=
ENGAGEMENT_MAX_SCOPE_ITEMS=100

MCP_IDENTITY_AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://your-mcp-app-registration
ENTRA_ISSUER=
ENTRA_JWKS_URI=
ENTRA_REQUIRED_SCOPES=
ENTRA_GROUPS_CLAIM=groups
ENTRA_ROLES_CLAIM=roles

MCP_GATEWAY_SHARED_SECRET=
MCP_GATEWAY_ALLOWED_ISSUERS=portkey,litellm
MCP_GATEWAY_MAX_CLOCK_SKEW_SECONDS=300
MCP_GATEWAY_NONCE_CACHE_SIZE=10000

XSIAM_CREDENTIAL_BROKER_ENABLED=false
XSIAM_CREDENTIAL_PROFILES={"Tier1":{"priority":10,"profile_name":"tier1-readonly","api_key_env":"XSIAM_T1_KEY","api_key_id_env":"XSIAM_T1_KEY_ID"}}

DATASET_QUERY_MAX_ROWS=100
DATASET_QUERY_MAX_FIELDS=25
DATASET_QUERY_MAX_FILTERS=20
DATASET_QUERY_MAX_METRICS=8
DATASET_QUERY_MAX_GROUP_FIELDS=5
DATASET_QUERY_MAX_RESPONSE_BYTES=65536
DATASET_QUERY_MAX_CELL_CHARS=2048
DATASET_QUERY_MAX_TIMEFRAME_MS=2592000000
# DATASET_QUERY_CURSOR_SECRET (long random value, required for continuation):
# inject at start like the API key.
DATASET_QUERY_CURSOR_TTL_SECONDS=900
XQL_MAX_CONCURRENT_QUERIES=4
XQL_MAX_QUERY_CHARS=32768
XQL_ENUM_FIELDS={}
XQL_TIMEOUT_CEILING_SECONDS=120
XQL_TIMEOUT_APPROVED_CEILING_SECONDS=300

COST_GUARD_ENABLED=true
COST_GUARD_UNIT_BANDS={"light":[0.001,0.5],"medium":[0.05,2.5],"heavy":[2,9],"extreme":[5,32]}
COST_GUARD_DATASET_TIERS={"xdr_data":"heavy","xdr_*":"heavy","*_story":"heavy","amazon_aws_raw":"heavy","msft_azure_raw":"heavy","google_gcp_*":"heavy","panw_ngfw_traffic_raw":"medium","panw_ngfw_url_raw":"medium","msft_azure_flowlogs_raw":"medium","xql_query_center_history":"light"}
COST_GUARD_DEFAULT_TIER=medium
COST_GUARD_SELECTIVE_FIELDS=agent_hostname,agent_id,endpoint_id,endpoint_name,host_name,hostname
COST_GUARD_PARTITION_FIELDS=event_type
COST_GUARD_HOST_FIELDS={"xdr_data":"agent_hostname"}
COST_GUARD_CHEAPER_DATASETS={"amazon_aws_raw":["cloud_audit_logs"],"msft_azure_raw":["cloud_audit_logs"]}
COST_GUARD_APPROVAL_THRESHOLD_UNITS=1.0
COST_GUARD_RESERVE_UNITS=20.0
COST_GUARD_APPROVAL_DAILY_CAP_UNITS=10.0
COST_GUARD_DAILY_QUOTA_UNITS=0
COST_GUARD_QUOTA_STALE_SECONDS=300
COST_GUARD_ELICITATION_ENABLED=true
COST_GUARD_ELICITATION_TIMEOUT_SECONDS=120
COST_GUARD_LONG_SLOT_SECONDS=60
COST_GUARD_LONG_SLOT_LIMIT=2
COST_GUARD_CACHE_TTL_SECONDS=600
COST_GUARD_CACHE_MAX_ENTRIES=64

# Endpoint script execution. Off by default. A run needs the switch, a group here, an
# allow-listed script uid and the analyst's approval. See docs/CONFIGURATION.md.
SCRIPT_RUN_ENABLED=false
SCRIPT_RUN_GROUPS=
# A JSON list of uids, or an object of uid to modification_date to pin the reviewed version.
SCRIPT_RUN_ALLOWED_SCRIPTS=[]
SCRIPT_RUN_MAX_ENDPOINTS=30
SCRIPT_RUN_DAILY_MAX_RUNS=5
SCRIPT_RUN_DAILY_MAX_ENDPOINTS=100
SCRIPT_RUN_ELICITATION_ENABLED=true
SCRIPT_RUN_ELICITATION_TIMEOUT_SECONDS=120
SCRIPT_RUN_MAX_OUTPUT_BYTES_PER_ENDPOINT=8192
SCRIPT_RUN_MAX_OUTPUT_BYTES=65536
SCRIPT_RUN_API_TIMEOUT_SECONDS=30
# Absolute private directory outside any git working tree for the run ledger. Empty keeps run
# records and daily caps in memory only, so a restart loses the records and resets the caps.
SCRIPT_RUN_STATE_DIR=
SCRIPT_RUN_RECORD_RETENTION_DAYS=30
# Absolute private directory outside any git working tree. Empty disables file retrieval.
SCRIPT_RUN_RESULTS_DIR=
SCRIPT_RUN_MAX_FILE_BYTES=52428800
SCRIPT_RUN_ALLOW_FOREIGN_ACTIONS=false

AUDIT_LOG_ENABLED=true
AUDIT_LOG_EMIT_START_EVENTS=true
AUDIT_LOG_INCLUDE_QUERY_TEXT=false
AUDIT_LOG_FAIL_CLOSED=false
AUDIT_LOG_XSIAM_HTTP_COLLECTOR_ENABLED=false
AUDIT_LOG_XSIAM_HTTP_COLLECTOR_URL=https://api-your-xsiam-tenant.example/logs/v1/event
# AUDIT_LOG_XSIAM_HTTP_COLLECTOR_API_KEY: inject at start.

TENANT_PACK_DIR=
LEARNING_ENABLED=true
LEARNING_SCHEMA_TTL_DAYS=30
LEARNING_COST_TTL_DAYS=90
LEARNING_ADMIN_GROUPS=Admin
LEARNING_VERIFY_MIN_CONFIRMATIONS=5
LEARNING_VERIFY_MIN_ENGAGEMENTS=3
LEARNING_VERIFY_MIN_DAYS=7
LEARNING_RESULT_CACHE_ENABLED=false
LEARNER_PRINCIPAL_ID=learning-service
LEARNER_GROUPS=learner
LEARNER_DAILY_UNIT_CAP=0.5
LEARNER_RESERVE_UNITS=20
LEARNER_ENGAGEMENT_CLOSE_SLA_MINUTES=15
LEARNER_ENGAGEMENT_IDLE_HOURS=24
LEARNER_NIGHTLY_UTC=13:30
LEARNER_WEEKLY_UTC="MON 20:00"
